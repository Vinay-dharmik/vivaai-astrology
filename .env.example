# VivaAI Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# ─── Razorpay (Payments) ───────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ─── NextAuth (Admin Panel Auth) ──────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=https://vivaai.in

# Admin login credentials (override the in-code defaults — recommended for production)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-strong-unique-password

# ─── Google Analytics & AdSense ───────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXX

# ─── Database (Optional — for future CMS features) ───
# Get from: https://neon.tech or https://supabase.com
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
